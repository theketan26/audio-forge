# ====================================================================
# 1. Neon PostgreSQL Database Configuration
# ====================================================================
# Connection string found in Neon Console: Dashboard -> Connection Details
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional custom table name (defaults to 'audio_generations')
DB_TABLE_NAME=audio_generations


# ====================================================================
# 2. Cloudflare R2 Storage Configuration (Private & Secure)
# ====================================================================
# S3 API URL from Cloudflare R2 Dashboard (found on your bucket or R2 overview)
# Example: https://<account_id>.r2.cloudflarestorage.com
R2_S3_API_URL=https://your-account-id.r2.cloudflarestorage.com

# R2 API Token credentials (from Cloudflare R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 Bucket name (stays 100% private, no public access required)
R2_BUCKET_NAME=your-r2-bucket-name
